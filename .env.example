# ─── HUMRAAH environment variables ───────────────────────────────
# Copy this file to `.env.local` and fill in ONE of the keys below. Never commit real keys.
# All variables are read on the SERVER only — nothing here is sent to the browser.
# Priority: ANTHROPIC_API_KEY → GEMINI_API_KEY → Demo Mode (built-in rule engine, clearly labelled).

# Option A (free): Google Gemini key from https://aistudio.google.com → "Get API key".
GEMINI_API_KEY=
# Optional: pin a Gemini model (default: gemini-flash-latest, Google's current free-tier Flash model).
# GEMINI_MODEL=gemini-flash-latest

# Option B (paid): Anthropic Claude key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default: claude-opus-5-5).
# HUMRAAH_MODEL=claude-opus-5-5
